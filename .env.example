# Optional locally: the database is saved to .data/postgres.
# Required on Vercel: pooled PostgreSQL URL from your database provider.
DATABASE_URL=
SITE_URL=http://localhost:5173
PORT=3001
# Local single-process database. Never use ephemeral serverless disk for data.
PGLITE_DATA_DIR=.data/postgres
# Optional one-time owner setup: a random 64-character hex token, server-only.
# Leave blank after setup. Never prefix either value with VITE_.
OWNER_SETUP_TOKEN=
OWNER_SETUP_EXPIRES_AT=
